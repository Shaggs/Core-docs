# Copy to .env (or run `python init_env.py` to generate one with random keys).
SECRET_KEY=generate-with-python-secrets.token_hex-32
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=
# Defaults to coresight.db in the project folder
# DATABASE_URL=sqlite:////absolute/path/coresight.db

# Behind a reverse proxy (nginx/Caddy/Traefik)? Set to 1.
# BEHIND_PROXY=1
# Max total size of attachments embedded in a playbook PDF (MB)
# PLAYBOOK_MAX_ATTACH_MB=100
# Directory containing DejaVuSans*.ttf for full Unicode in playbook PDFs
# PLAYBOOK_FONT_DIR=
# Enable Flask debug mode (development only, never in production)
# FLASK_DEBUG=1

# Public URL of this install (links in expiry-alert emails)
# APP_BASE_URL=https://vault.example.com
# Encrypts backups (python backup.py create / Admin > Backups). Needed to restore.
# BACKUP_PASSPHRASE=
# BACKUP_KEEP=14
# BACKUP_DIR=/path/to/backups
# Where uploaded documents are stored (default: ./uploads)
# UPLOAD_DIR=/path/to/uploads
# Force the Secure flag on the session cookie (automatic when BEHIND_PROXY=1)
# COOKIE_SECURE=1

# Local timezone (Docker scheduler + log times), e.g. Australia/Sydney
# TZ=Australia/Sydney
